  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "webhookSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Signature",
        "description": "HMAC-SHA256(secret, timestamp + punto + cuerpo JSON exacto), X-Timestamp milisegundos, ventana 5 min. Evento deduplicado."
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "required": ["type", "title", "status", "detail", "instance", "correlationId"]
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 120
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": ["email", "password"]
      },
      "Actor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sub": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "enum": ["asesor", "supervisor", "administrador"]
          },
          "agency": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": ["sub", "role", "agency", "name"]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/Actor"
          },
          "expiresIn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        },
        "required": ["token", "user", "expiresIn"]
      },
      "Client": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 120
          },
          "identification": {
            "type": "string",
            "pattern": "^DEMO-[0-9]{6}$"
          },
          "incomeCents": {
            "type": "integer",
            "minimum": 10000,
            "maximum": 100000000
          }
        },
        "required": ["name", "email", "identification", "incomeCents"]
      },
      "Vehicle": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "brand": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2030
          },
          "priceCents": {
            "type": "integer",
            "minimum": 100000,
            "maximum": 20000000
          }
        },
        "required": ["brand", "model", "year", "priceCents"]
      },
      "Financing": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "downPaymentCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "termMonths": {
            "type": "integer",
            "enum": [12, 24, 36, 48, 60, 72]
          }
        },
        "required": ["downPaymentCents", "termMonths"]
      },
      "Consent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "type": "boolean",
            "enum": [true]
          },
          "channel": {
            "type": "string",
            "enum": ["web", "agencia"]
          },
          "evidence": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          }
        },
        "required": ["accepted", "channel", "evidence"]
      },
      "ApplicationInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client": {
            "$ref": "#/components/schemas/Client"
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "financing": {
            "$ref": "#/components/schemas/Financing"
          },
          "consent": {
            "$ref": "#/components/schemas/Consent"
          },
          "banks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["pichincha", "pacifico"]
            },
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          },
          "scenario": {
            "type": "string",
            "enum": [
              "aprobada",
              "condiciones",
              "rechazada",
              "informacion",
              "demora",
              "temporal",
              "timeout"
            ]
          }
        },
        "required": ["client", "vehicle", "financing", "consent", "banks", "scenario"]
      },
      "Offer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "bank": {
            "type": "string",
            "enum": ["pichincha", "pacifico"]
          },
          "annualRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "termMonths": {
            "type": "integer",
            "minimum": 12,
            "maximum": 72
          },
          "installmentCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "downPaymentCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "insuranceCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 10
          }
        },
        "required": [
          "id",
          "bank",
          "annualRate",
          "termMonths",
          "installmentCents",
          "downPaymentCents",
          "insuranceCents",
          "conditions"
        ]
      },
      "Audit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "required": ["at", "actor", "action", "correlationId"]
      },
      "Submission": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "PENDIENTE",
              "EN_ANALISIS",
              "APROBADA",
              "CONDICIONES",
              "RECHAZADA",
              "INFORMACION",
              "ERROR"
            ]
          },
          "externalId": {
            "type": "string"
          },
          "offer": {
            "$ref": "#/components/schemas/Offer"
          },
          "jobState": {
            "type": "string",
            "enum": ["pending", "leased", "done", "dead"]
          }
        },
        "required": ["state", "jobState"]
      },
      "Application": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "agency": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["ENVIADA", "OFERTAS", "SIN_OFERTAS", "ACEPTADA", "DESISTIDA"]
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "client": {
            "$ref": "#/components/schemas/Client"
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "financing": {
            "$ref": "#/components/schemas/Financing"
          },
          "banks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["pichincha", "pacifico"]
            }
          },
          "scenario": {
            "type": "string",
            "enum": [
              "aprobada",
              "condiciones",
              "rechazada",
              "informacion",
              "demora",
              "temporal",
              "timeout"
            ]
          },
          "submissions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pichincha": {
                "$ref": "#/components/schemas/Submission"
              },
              "pacifico": {
                "$ref": "#/components/schemas/Submission"
              }
            }
          },
          "audit": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Audit"
            }
          },
          "acceptedOfferId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "agency",
          "state",
          "version",
          "createdAt",
          "client",
          "vehicle",
          "financing",
          "banks",
          "scenario",
          "submissions",
          "audit"
        ]
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Application"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          }
        },
        "required": ["items", "page", "size", "total"]
      },
      "BankResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "bank": {
            "type": "string",
            "enum": ["pichincha", "pacifico"]
          },
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "decision": {
            "type": "string",
            "enum": ["APROBADA", "CONDICIONES", "RECHAZADA", "INFORMACION"]
          },
          "offer": {
            "$ref": "#/components/schemas/Offer"
          }
        },
        "required": ["eventId", "applicationId", "bank", "externalId", "decision"]
      },
      "Ack": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "type": "boolean"
          }
        },
        "required": ["accepted"]
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "required": ["status"]
      },
      "Bank": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": ["pichincha", "pacifico"]
          },
          "name": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "academic": {
            "type": "boolean"
          }
        },
        "required": ["id", "name", "protocol", "academic"]
      },
      "Metrics": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "failures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "uptimeSeconds": {
            "type": "number"
          },
          "memoryRssBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000000000
          },
          "cpuUserMicros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "cpuSystemMicros": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "queuePending": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "queueDead": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          }
        },
        "required": [
          "requests",
          "failures",
          "uptimeSeconds",
          "memoryRssBytes",
          "cpuUserMicros",
          "cpuSystemMicros",
          "queuePending",
          "queueDead"
        ]
      }
    }
  }
}
